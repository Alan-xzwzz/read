# Shell scripts must stay LF so they work in Linux containers and WSL.
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and docs use LF.
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary assets.
*.jar binary
*.wasm binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.frag binary
